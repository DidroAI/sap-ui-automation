{
  "manifest_version": 3,
  "name": "SAP UI MCP",
  "short_name": "SAP UI MCP",
  "description": "Let AI agents see and interact with SAP screens from Chrome. Passwords stay in your keychain. Not affiliated with SAP SE.",
  "version": "0.4.4",
  "minimum_chrome_version": "132",
  "homepage_url": "https://docs.didro.ai/sap-ui-automation/chrome-extension/",
  "key": "",
  "permissions": [
    "debugger",
    "storage",
    "alarms",
    "nativeMessaging",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "SAP UI MCP",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
